# Required: your Teamso personal access token (create one at https://teamso.com/dashboard/mcp-access)
TEAMSO_ACCESS_TOKEN=tms_pat_your-token

# Optional: override the API base URL (default: https://api.teamso.com/v1)
# TEAMSO_API_BASE_URL=https://api.teamso.com/v1

# Optional: site that serves the public help articles (default: https://teamso.com)
# TEAMSO_HELP_BASE_URL=https://teamso.com
